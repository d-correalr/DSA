    <diagram id="salud2attempt01" name="Salud_administración">
        <mxGraphModel dx="1494" dy="1139" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="Salud" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#008a00;strokeColor=#005700;fontColor=#ffffff;" parent="1" vertex="1">
                    <mxGeometry x="40" y="30" width="80" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="1. ¿Cuántas personas afiliadas al régimen contributivo en salud en el ERON recibieron órdenes de medicina especializada en el último trimestre?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="40" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="2. ¿Cuántas de las personas afiliadas al régimen contributivo en salud que recibieron órdenes de medicina especializada recibieron el servicio durante los 90 días siguientes a la emisión de la orden?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="135" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="3. ¿Cuántas personas afiliadas al Fondo Nacional de Salud en el ERON recibieron órdenes de medicina especializada en el último trimestre?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="230" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="4. ¿Cuántas de las personas afiliadas al Fondo Nacional de Salud que recibieron órdenes de medicina especializada recibieron el servicio durante los 90 días siguientes a la emisión de la orden?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="325" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="115" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;fillColor=#f8cecc;strokeColor=#b85450;" edge="1" parent="1" source="7" target="9">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="5.&amp;nbsp;Durante el último trimestre, ¿se presentaron barreras para garantizar la asistencia a citas de medicina especializada dentro de los 90 días siguientes a la orden médica?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="420" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="10. ¿A qué se debieron las dificultades en la asistencia a citas de medicina especializada?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="530" y="500" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="11.&amp;nbsp;En el último trimestre, ¿se presentaron dificultades específicas para garantizar atención médica especializada relacionada con salud sexual y reproductiva (por ejemplo ginecología, obstetricia, ITS)?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="176" y="610" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="12. ¿Cuántas personas afiliadas al régimen contributivo en salud en el ERON recibieron órdenes de medicamentos el último mes?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="705" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="13.&amp;nbsp;¿Cuántas de las personas del régimen contributivo que recibieron órdenes de medicamentos los recibieron en máximo 72 horas después de la emisión de la receta?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="800" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="14.&amp;nbsp;¿Cuántas personas afiliadas al Fondo Nacional de Salud en el ERON recibieron órdenes de medicamentos el último mes?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="895" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="15. ¿Cuántas de las personas del Fondo Nacional de Salud que recibieron órdenes de medicamentos los recibieron en máximo 72 horas después de la emisión de la receta?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="990" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="125" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fillColor=#f8cecc;strokeColor=#b85450;" edge="1" parent="1" source="14" target="16">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="16.&amp;nbsp;¿Se han presentado inconvenientes en el último trimestre para garantizar entrega oportuna de medicamentos a personas privadas de la libertad con fórmula médica expedida en las 72 horas siguientes a la emisión de la orden médica?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="1085" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="17.&amp;nbsp;¿A qué se debieron las dificultades en la entrega oportuna de medicamentos (72 horas posteriores a la emisión de orden médica)?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="520" y="1160" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="18. En el último trimestre, ¿se presentaron dificultades específicas para garantizar la entrega de medicamentos relacionados con salud sexual y reproductiva (por ejemplo anticoncepción, ITS, control prenatal cuando aplica)?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="180" y="1275" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="129" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;fillColor=#f8cecc;strokeColor=#b85450;" edge="1" parent="1" source="17" target="19">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="19.&amp;nbsp;¿Se contó con presencia de al menos un médico general las 24 horas del día en el establecimiento durante el último mes?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="1370" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="18" value="20.&amp;nbsp;¿por qué no se contó con médico general de forma permanente en el ERON?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="520" y="1450" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="21.&amp;nbsp;En el periodo de medición, ¿cuántas personas ingresaron al establecimiento?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="1560" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="22. De las personas que ingresaron durante el periodo de medición, ¿a cuántas se les realizó examen médico integral dentro de las 72 horas siguientes al ingreso?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="1655" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="23.&amp;nbsp;En el examen médico de ingreso, ¿se incluye valoración de salud sexual y reproductiva (incluye prueba de embarazo cuando aplica)?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="180" y="1750" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="24.&amp;nbsp;En el periodo de medición, ¿cuántas personas privadas de la libertad fueron diagnosticadas con patologías infectocontagiosas?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="1845" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="25.&amp;nbsp;De las personas diagnosticadas con patologías infectocontagiosas en el periodo de medición, ¿cuántas requirieron aislamiento sanitario según indicación médica?" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="1940" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="24" value="26. De las personas que requirieron aislamiento sanitario en el periodo de medición, ¿cuántas recibieron aislamiento en un espacio adecuado? Se entiende por espacio adecuado aquel separado de la población general y con condiciones mínimas de ventilación y control sanitario" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="180" y="2035" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="25" value="27.&amp;nbsp;Actualmente, ¿cuántas mujeres embarazadas se encuentran en el establecimiento?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="180" y="2130" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="26" value="28.&amp;nbsp;De las mujeres embarazadas actualmente en el establecimiento, ¿a cuántas se les ha realizado al menos un control prenatal en el último mes?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="180" y="2225" width="320" height="70" as="geometry"/>
                </mxCell>
